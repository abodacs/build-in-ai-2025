{
  "name": "chrome-ai-devbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive learning playground for Chrome's built-in AI APIs",
  "keywords": [
    "chrome",
    "ai",
    "developer-tools",
    "react",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 100",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:cloudflare": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=8192' vitest run tests/unit",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=8192' vitest run tests/integration",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "check:duplication": "npx jscpd src",
    "check:duplication:report": "npx jscpd src --reporters html,console",
    "build:cloudflare": "pnpm type-check && pnpm lint:cloudflare && pnpm build",
    "deploy:preview": "pnpm build:cloudflare && wrangler pages deploy dist --commit-dirty=true",
    "deploy:production": "pnpm build:cloudflare && wrangler pages deploy dist --project-name chrome-ai-devbench --commit-dirty=true",
    "prepare": "husky",
    "postinstall": "pnpm dlx shadcn-ui@latest init --yes --typescript --tailwind --css-variables --import-alias '@' --src-dir",
    "dev:open": "vite --open",
    "analyze": "pnpm build && npx vite-bundle-analyzer dist",
    "clean": "rm -rf dist node_modules/.vite",
    "update-deps": "pnpm update --interactive",
    "check-deps": "pnpm audit && pnpm outdated"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "secretlint"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/dom-speech-recognition": "^0.0.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.2.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.63.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.1.1",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dom-chromium-ai": "^0.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "axe-core": "^4.11.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "react-markdown": "^10.1.0",
    "secretlint": "^11.2.4",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^4.1.13",
    "terser": "^5.44.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6.0.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-compression2": "^2.2.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.40.2"
  }
}
