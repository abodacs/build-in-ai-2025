{
  "name": "chrome-ai-devbench",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Interactive learning playground for Chrome's built-in AI APIs",
  "keywords": [
    "chrome",
    "ai",
    "developer-tools",
    "react",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "build:cloudflare": "pnpm type-check && pnpm lint && pnpm build",
    "deploy:preview": "pnpm build:cloudflare && wrangler pages deploy dist",
    "deploy:production": "pnpm build:cloudflare && wrangler pages deploy dist --project-name chrome-ai-devbench",
    "prepare": "husky",
    "postinstall": "pnpm dlx shadcn-ui@latest init --yes --typescript --tailwind --css-variables --import-alias '@' --src-dir",
    "dev:open": "vite --open",
    "analyze": "pnpm build && npx vite-bundle-analyzer dist",
    "clean": "rm -rf dist node_modules/.vite",
    "update-deps": "pnpm update --interactive",
    "check-deps": "pnpm audit && pnpm outdated"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "secretlint"
    ]
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/dom-speech-recognition": "^0.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "react-syntax-highlighter": "^15.6.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dom-chromium-ai": "^0.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.2",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "secretlint": "^11.2.4",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5",
    "vite": "^6.0.6",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.1"
  }
}